    <string name="localadb_off_title_dev">Activa Opciones de desarrollador</string>
    <string name="localadb_off_body_dev">Android las oculta hasta que toques 7 veces «Número de compilación». Una app no puede activar la depuración por sí sola.</string>
    <string name="localadb_off_title_adb">Activa la Depuración USB</string>
    <string name="localadb_off_body_adb">Opciones de desarrollador ya está activo. Solo falta permitir la depuración USB para que adbd acepte la conexión local.</string>
    <string name="localadb_step_1">Abre Información del teléfono</string>
    <string name="localadb_step_2">Toca 7 veces «Número de compilación»</string>
    <string name="localadb_step_3">Entra en Opciones de desarrollador</string>
    <string name="localadb_step_4">Activa «Depuración USB»</string>
    <string name="localadb_open_device_info">Información del teléfono</string>
    <string name="localadb_dev_options_on">Opciones de desarrollador activadas</string>
    <string name="localadb_dev_options_off">Opciones de desarrollador desactivadas</string>
    <string name="localadb_off_auto_retry">Al volver, la app comprueba el estado y reintenta sola.</string>
    <string name="localadb_open_dev_settings">Abrir opciones de desarrollador</string>
    <string name="localadb_retry">Reintentar</string>
    <string name="localadb_waiting_title">Acepta la autorización</string>
    <string name="localadb_waiting_body">Marca “Permitir siempre” en el diálogo RSA para conservar el acceso. Si no aparece, revisa la pantalla y vuelve a intentarlo.</string>
    <string name="localadb_attempt">Intento %1$d de %2$d</string>
    <string name="localadb_error_port_title">El puerto 5555 está cerrado</string>
    <string name="localadb_error_port_body">adbd no acepta la conexión. Activa «Depuración inalámbrica» en Opciones de desarrollador y pulsa Reintentar. Si tu equipo solo ofrece depuración USB, conéctalo a un PC y ejecuta una vez:\n\nadb tcpip 5555</string>
    <string name="localadb_error_auth_title">Autorización pendiente o denegada</string>
    <string name="localadb_error_auth_body">No se recibió permiso RSA. Acepta “Permitir siempre” en el dispositivo y vuelve a intentarlo.</string>
    <string name="localadb_error_disconnected_title">La sesión se cerró</string>
    <string name="localadb_error_disconnected_body">El dispositivo cerró la conexión ADB. Comprueba que la depuración sigue activa y reintenta.</string>
    <string name="localadb_error_unknown_title">No se pudo conectar</string>
    <string name="localadb_error_unknown_body">Revisa la depuración USB y vuelve a intentarlo.</string>
    <string name="localadb_connected_note">Sesión local activa: las herramientas ADB de la app usan esta conexión.</string>
    <string name="localadb_quick">Comandos rápidos</string>
    <string name="localadb_command_hint">Comando shell (pm, settings, am…)</string>
    <string name="localadb_run">Ejecutar</string>
    <string name="localadb_clear">Limpiar</string>
    <string name="localadb_output">Salida</string>
    <string name="localadb_output_empty">Aún no hay comandos. Prueba uno rápido o escribe el tuyo.</string>
    <string name="localadb_exit_ok">exit 0</string>
    <string name="localadb_exit_error">exit %1$d</string>
    <string name="localadb_duration">%1$d ms</string>
    <string name="localadb_log_title">Registro de conexión</string>
    <string name="localadb_endpoint_local">este dispositivo</string>
    <string name="localadb_pairing_searching_title">Buscando el puerto de vinculación</string>
    <string name="localadb_pairing_searching_body">Abre Opciones de desarrollador → Depuración inalámbrica y toca «Vincular dispositivo con código». La app detecta el puerto automáticamente.</string>
    <string name="localadb_pairing_title">Escribe el código de vinculación</string>
    <string name="localadb_pairing_body">Android muestra un código de 6 dígitos en el diálogo de vinculación. Escríbelo aquí para autorizar esta app; solo hace falta una vez.</string>
    <string name="localadb_pairing_port">Puerto de vinculación: %1$d</string>
    <string name="localadb_pairing_code_hint">Código de 6 dígitos</string>
    <string name="localadb_pairing_confirm">Vincular</string>
    <string name="localadb_pairing_working">Vinculando…</string>
    <string name="localadb_pairing_action">Vincular con código</string>
    <string name="localadb_error_pairing_title">Falta vincular la depuración inalámbrica</string>
    <string name="localadb_error_pairing_body">Android 11 o superior exige vincular antes de aceptar la sesión. Activa «Depuración inalámbrica», toca «Vincular dispositivo con código» y pulsa «Vincular con código» aquí.</string>
    <string name="localadb_error_pairing_failed_title">No se pudo vincular</string>
    <string name="localadb_error_pairing_failed_body">Revisa que el código sea el que muestra el diálogo y que la depuración inalámbrica siga activa. Vuelve a intentarlo.</string>
    <string name="localadb_tools_description">Conecta por 127.0.0.1 y ejecuta comandos shell</string>
</resources>
